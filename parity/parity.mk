# Parity suite: neokapi's Go ports head-to-head against this bridge.
# Included by the root Makefile; see parity/README.md.
#
# `make parity-test` builds a sandbox (a released kapi + a freshly built
# plugin tarball) under .parity/ and runs every parity test in parity/...
# against it. The sandbox is reused across runs; PARITY_FORCE=1 rebuilds it.
#
# KAPI_BIN       kapi binary to test (default: kapi on PATH)
# OKAPI_VERSION  Okapi version to build the plugin for (default: 1.48.0)

PARITY_DIR     := $(CURDIR)/.parity
PARITY_REPORT  := $(PARITY_DIR)/test-comparison.json
PARITY_SUMMARY := $(PARITY_DIR)/parity-report.json
OKAPI_VERSION  ?= 1.48.0

# Go does not union repeated -tags flags (the last one wins), so every tag
# the suite needs is spelled in one flag.
PARITY_GO_TAGS := fts5,parity

parity-sandbox:
	@OKAPI_VERSION=$(OKAPI_VERSION) $(CURDIR)/parity/scripts/sandbox.sh > /dev/null
	@echo "Parity sandbox: $(PARITY_DIR)"

parity-test: parity-sandbox
	cd parity && KAPI_PARITY_SANDBOX=$(PARITY_DIR) KAPI_PARITY_REPORT=$(PARITY_REPORT) \
	    go test -tags "$(PARITY_GO_TAGS)" -count=1 -timeout 60m ./...
	@echo "Parity report: $(PARITY_REPORT)"

parity-publish: parity-test
	cd parity && go run ./cmd/testcompare -in $(PARITY_REPORT) -out $(PARITY_SUMMARY)
	@echo "Parity summary: $(PARITY_SUMMARY)"

parity-vet:
	cd parity && go vet -tags "$(PARITY_GO_TAGS)" ./...

parity-clean:
	rm -rf $(PARITY_DIR)

# Re-extract parity/formats/fixtures_*_generated.go from the upstream Okapi
# Java @Test classes. They are not regenerated by `make parity-test` and carry
# no //go:generate directive (the source path is machine-specific). Refresh
# them after bumping OKAPI_VERSION or when upstream adds fixtures, then review
# the diff. OKAPI_REPO names a checkout of the Okapi Framework at that version.
# The class lists are the source of truth for what each file extracts; keep
# them in committed order so regeneration stays byte-stable.
OKAPI_REPO ?=
OKAPI_FIXTURE_SPECS := \
	dtd=DTDFilterTest \
	html=HtmlConfigurationSupportTest,HtmlEventTest,HtmlSnippetsTest,SkipEncodingDeclarationTest \
	json=JSONFilterTest,JsonSnippetParserTest \
	markdown=MarkdownFilterTest,MarkdownWriterTest \
	po=POFilterTest,POWriterTest \
	properties=PropertiesFilterTest \
	regex=RegexFilterTest \
	tmx=TmxFilterTest \
	ts=TsFilterTest \
	wiki=WikiFilterTest,WikiWriterTest \
	xliff=XLIFFFilterTest,XLIFFFilterXtmPropTest \
	yaml=YamlFilterTest,YamlParserTest,YmlFilterTest

regen-okapi-fixtures:
	@[ -n "$(OKAPI_REPO)" ] && [ -d "$(OKAPI_REPO)/okapi/filters" ] || { echo "set OKAPI_REPO to an Okapi Framework checkout"; exit 1; }
	@cd parity && set -e; for spec in $(OKAPI_FIXTURE_SPECS); do \
	    fmt=$${spec%%=*}; classes=$${spec#*=}; \
	    echo "[regen] $$fmt ($$classes)"; \
	    go run ./cmd/okapi-test-scan \
	        -src $(OKAPI_REPO)/okapi/filters \
	        -class "$$classes" \
	        -package formats \
	        -out formats/fixtures_$${fmt}_generated.go; \
	done
	@echo "[regen] done; review 'git diff parity/formats/fixtures_*_generated.go'"

.PHONY: parity-sandbox parity-test parity-publish parity-vet parity-clean regen-okapi-fixtures
